{
  "name": "task-api",
  "version": "1.0.0",
  "description": "Workshop-App: Task-API mit Auth, SQLite und sauberen Modulgrenzen",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"node --disable-warning=ExperimentalWarning\"",
    "start:dev": "nest start --watch --exec \"node --disable-warning=ExperimentalWarning\"",
    "start:prod": "node --disable-warning=ExperimentalWarning dist/main",
    "lint": "oxlint src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  }
}
