{
  "name": "task-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.js",
    "#tasks/*": "./src/tasks/*.js"
  },
  "exports": {
    ".": "./src/app.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.js",
    "test": "node --test --disable-warning=ExperimentalWarning"
  }
}
